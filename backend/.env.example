# 复制成 .env 再填。只有模型的 key 是必填的，其余都有默认值或是可选功能。

# ---- 模型（必填）：默认走 DeepSeek 的 Anthropic 兼容接口 ----
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=
MODEL=deepseek-flash
MAX_TOKENS=64000

# ---- 知识库（可选）：SiliconFlow 的 embedding 和 rerank ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# KB_REWRITE=1            # 查询改写，默认关
# KB_REWRITE_MODEL=

# ---- 代码沙箱（可选）：E2B 协议的服务，不配就不注册沙箱工具 ----
# E2B_API_URL=
# E2B_SANDBOX_URL=
# E2B_API_KEY=
# CUBE_TEMPLATE_ID=

# ---- 其他（都有默认值）----
# DATABASE_URL=postgresql://oasis:oasis@127.0.0.1:5433/oasis
# DEMO_TOKEN=demo-token
# GUEST_TOKEN=guest-token
# WEB_TOOLS=0             # 关掉联网工具
# SUBAGENTS=0             # 关掉子智能体
